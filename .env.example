# VitalOS Environment Variables
# Copy to .env and fill in real values. NEVER commit .env.

# Supabase — find in your project: Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# App
VITE_APP_URL=https://vitalos.space

# Data providers (Phase 2)
# VITE_DEFILLAMA_BASE=https://api.llama.fi
# VITE_COINGECKO_API_KEY=


# Web3 subscriptions — Base / Unlock Protocol
# Deploy one Unlock PublicLock per paid tier, then set these public contract addresses.
# Never put private keys or seed phrases in VITE_* variables.
VITE_LOCK_VALIDATOR=
VITE_LOCK_STAKER=
VITE_LOCK_ARCHITECT=
VITE_LOCK_PROTOCOL=

# Production RPCs (optional; public RPC fallback is used if unset)
VITE_RPC_ETHEREUM=
VITE_RPC_BASE=
VITE_RPC_ARBITRUM=
VITE_RPC_OPTIMISM=
VITE_RPC_POLYGON=

# Bitcoin payments — optional Phase 4 BTCPay integration
# VITE_BTCPAY_URL=
# VITE_BTCPAY_STORE_ID=
# Never put a BTCPay private/API secret in the Vite client.
