{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vitalos-web",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-29",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "build": {
    "command": "npm run build"
  }
}
