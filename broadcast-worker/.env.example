PORT=8788
BROADCAST_CONTROL_TOKEN=replace-with-a-long-random-secret
TWITCH_INGEST_URL=rtmp://your-selected-ingest-server/app
TWITCH_STREAM_KEY=stored-only-on-the-persistent-encoder-host
# Optional external AI Producer endpoint. It receives {scene, mode, context} and returns {title, body, disclosure}.
AI_PRODUCER_URL=
# Automatic scene rotation interval in milliseconds; 300000 = 5 minutes.
SCENE_ROTATION_MS=300000
